# Test database for `pnpm test` (copy to .env.test, which is git-ignored).
# Must be a local database whose name ends in _test: every run drops and rebuilds its schema.
# Payload creates the database on the first run if it does not exist.
# Anything not set here is read from .env (PAYLOAD_SECRET, …).
DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/cms_test

# every host serves the admin tenant unless a test sets its own
TENANT_BASE_DOMAIN=
TRUST_PROXY=false
DB_LOGGER=false
